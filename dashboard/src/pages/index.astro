---
// src/pages/index.astro
// Array of available specs in your project
const AVAILABLE_SPECS = [
  { label: 'Login Workflows', path: 'tests/login.spec.ts' },
  { label: 'Inventory Workflows', path: 'tests/inventory.spec.ts' },
  { label: 'Checkout Workflows', path: 'tests/checkout.spec.ts' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Playwright Test Control Center</title>
    <style>
      :root {
        --bg: #0d1117;
        --card-bg: #161b22;
        --border: #30363d;
        --text: #c9d1d9;
        --accent: #238636;
        --accent-hover: #2ea043;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: var(--bg);
        color: var(--text);
        margin: 0;
        padding: 30px;
      }
      .container { max-width: 1000px; margin: 0 auto; }
      .card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
      }
      h1, h2 { color: #f0f6fc; margin-top: 0; }
      .grid { display: grid; gap: 12px; margin: 15px 0; }
      label { display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 15px; }
      input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--accent); }
      input[type="password"] {
        width: 100%;
        padding: 10px;
        background: #0d1117;
        border: 1px solid var(--border);
        border-radius: 6px;
        color: white;
        box-sizing: border-box;
      }
      button {
        background: var(--accent);
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
        font-size: 15px;
      }
      button:hover { background: var(--accent-hover); }
      .status { margin-top: 15px; font-weight: bold; }
      iframe {
        width: 100%;
        height: 700px;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: white;
      }
      a { color: #58a6ff; text-decoration: none; }
      a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>🚀 Playwright Test Control Center</h1>

      <!-- Authentication -->
      <div class="card">
        <h2>1. Authentication</h2>
        <label for="pat">GitHub Personal Access Token (PAT):</label>
        <input type="password" id="pat" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx" />
      </div>

      <!-- Spec Selection -->
      <div class="card">
        <h2>2. Select Specs to Execute</h2>
        <div class="grid">
          {AVAILABLE_SPECS.map(spec => (
            <label>
              <input type="checkbox" class="spec-check" value={spec.path} />
              <strong>{spec.label}</strong> <code>({spec.path})</code>
            </label>
          ))}
        </div>
        <button id="runBtn">Run Selected Tests</button>
        <div id="status" class="status"></div>
      </div>

      <!-- Live Logs Card -->
      <div class="card" id="logsCard" style="display: none;">
        <h2>3. Pipeline Status</h2>
        <p>Execution triggered in GitHub Actions!</p>
        <a id="actionLink" href="#" target="_blank">View Live Run Logs ↗</a>
      </div>

      <!-- Embedded Playwright Report -->
      <div class="card">
        <h2>4. Latest Test Report</h2>
        <iframe src="report/index.html"></iframe>
      </div>
    </div>

    <script>
      // Browser-side script to trigger workflow
      const OWNER = 'YOUR_GITHUB_USERNAME'; // Replace with your username
      const REPO = 'YOUR_REPO_NAME';       // Replace with your repo name
      const WORKFLOW_ID = 'astro-playwright.yml';

      const runBtn = document.getElementById('runBtn');
      const statusDiv = document.getElementById('status');
      const logsCard = document.getElementById('logsCard');
      const actionLink = document.getElementById('actionLink') as HTMLAnchorElement;

      runBtn?.addEventListener('click', async () => {
        const patInput = document.getElementById('pat') as HTMLInputElement;
        const token = patInput?.value.trim();

        if (!token) {
          alert('Please provide a GitHub Personal Access Token.');
          return;
        }

        const selectedSpecs = Array.from(document.querySelectorAll('.spec-check:checked'))
          .map(cb => (cb as HTMLInputElement).value);

        if (selectedSpecs.length === 0) {
          alert('Please select at least one spec file to run.');
          return;
        }

        statusDiv!.innerText = 'Triggering workflow via GitHub API...';

        try {
          const res = await fetch(`https://api.github.com/repos/${OWNER}/${REPO}/actions/workflows/${WORKFLOW_ID}/dispatches`, {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Accept': 'application/vnd.github+json',
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              ref: 'main',
              inputs: {
                specs: selectedSpecs.join(' ')
              }
            })
          });

          if (res.ok) {
            statusDiv!.innerText = '✅ Test run successfully requested!';
            logsCard!.style.display = 'block';
            actionLink!.href = `https://github.com/${OWNER}/${REPO}/actions`;
          } else {
            const err = await res.json();
            statusDiv!.innerText = `❌ Error: ${err.message || res.statusText}`;
          }
        } catch (err: any) {
          statusDiv!.innerText = `❌ Request failed: ${err.message}`;
        }
      });
    </script>
  </body>
</html>